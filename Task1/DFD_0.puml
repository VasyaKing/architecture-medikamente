@startuml
title DFD-0: Общие потоки данных в компании "Медикаменте"

' ---- Внешние сущности (роли) ----
actor Patient            as P
actor "Administrator"    as A
actor "Doctor"           as D
actor "Cassier"          as C
actor "Bookkeeper"       as B
actor "Warehouse keeper" as W
actor "Laboratory staff" as L

' ---- Основные системы / хранилища ----
node "File system / FileServer\n(общий диск)" as FS
rectangle "1C Бухгалтерия предприятия\n(учёт платежей, ЗП, налоги)" as Acc1C
rectangle "1C Торговля и склад\n(учёт ТМЦ)" as Trade1C
rectangle "ККМ\n(контрольно-кассовая машина)" as KKM
rectangle "Exchange Mail Server\n(внутренняя почта)" as Mail
rectangle "Система лаборатории\n(внешняя организация)" as LabSys

' Внутренние логические хранилища на файловой системе (укрупнённо)
folder "Journals\n(журналы записей к врачам)" as Journals
folder "Pacients/*\n(папки пациентов с медкартами)" as Pacients
folder "Laboratory Registry\n(реестры и результаты анализов)" as LabReg

FS -- Journals
FS -- Pacients
FS -- LabReg

' ---- Регистрация и медкарта пациента ----
P --> A : ПДн, контакты,\nжалобы, запрос на запись
A --> Journals : Запись пациента в журнал\nк конкретному врачу
A --> Pacients : Создание/изменение\nкарточки пациента\n(файлы, папки)

D --> Pacients : Чтение/добавление\nмеддокументов пациента

' ---- Лабораторные анализы ----
D --> LabSys : Направления на анализы\n(списки пациентов)
L --> LabReg : Реестры и результаты\nанализов (файлы)
D --> LabReg : Просмотр результатов\nпо пациенту

' ---- Платежи и бухгалтерия ----
P --> C : Оплата услуг
C --> KKM : Пробитие чека
KKM --> Acc1C : Данные о принятых платежах\n(дата, сумма, операция)
B --> Acc1C : Обработка платежей,\nбухгалтерский учёт

' ---- Учёт ТМЦ ----
W --> Trade1C : Данные о приходе/расходе ТМЦ
Trade1C --> Acc1C : Обмен данными по ТМЦ\n(стоимость, счета учёта)

' ---- Электронная почта как канал передачи данных ----
A --> Mail : Отправка/получение писем\nсо сканами документов пациентов
D --> Mail : Отправка/получение\nмеддокументов, результатов анализов
B --> Mail : Счета, акты,\nфинансовые документы
W --> Mail : Накладные, заявки,\nдокументы по складу
L --> Mail : Реестры и результаты анализов\nво вложениях

@enduml
