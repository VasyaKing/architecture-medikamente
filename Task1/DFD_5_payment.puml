@startuml
title DFD-5: Оплата услуг и учёт платежей

actor Patient as P
actor "Cassier" as C
actor "Bookkeeper" as B

rectangle "ККМ\n(контрольно-кассовая машина)" as KKM
rectangle "1C Бухгалтерия предприятия\n(файловый режим)" as Acc1C

P --> C : передаёт деньги/карту\nдля оплаты услуг
C --> KKM : вводит сумму, вид услуги,\nпри необходимости данные клиента
KKM --> P : печатает чек
KKM --> Acc1C : передаёт данные о чеке:\nдата, время, сумма,\nтип операции, реквизиты
B --> Acc1C : обрабатывает данные чеков,\nформирует проводки и отчёты

@enduml
